# About null safety:
# ?. to dereference safely (return null)
# !. to dereference and panic if null (only in debug builds, otherwise same as ?. in release build) (to implement)
# ?? to return a value on the right if the left operand is null
# ??= only assign if left operand is null
# ?|> (same as ?. but for function piping) (to implement)
# !|> (same as !. but for function piping) (to implement)
# Every single type can have a ? after them
# Can do this, skip if null: a?.b?.c = 10

let Array(Int?)? lmao

let misc = Func(Int a:) {
	let Int | String i = select (a == 10: 27, true: "lmao")
	# i is now either `27` or `"lmao"`
	{
		defer print("3rd")
		defer print("2nd")
		defer print("1st")
	} # prints 1st, 2nd, 3rd at the end of this scope
	print(ls[
		2
		+
		3
	])
	let interpolated = "hello {some_var} <- that's a var"
	(
		2
		+
		3
	)
	# This aint allowed bitch
	#   2
	#   +
	#   3
	# But this is :D
	print(
		2
		+
		3
	)
	# But again, this isn't
	#   print
	#   (2 + 3)
}

let control_flow = Func(:) {
	loop over ls -> index, elem { }
	loop over ls -> elem {
		continue
	}
	loop over ls {
		break
	}

	loop from 0 to 10 { }
	loop from 0 to 10 -> i { }
	loop from 0 to 10 by 2 { }
	loop from 0 to 10 by 2 -> u { }
	loop to 10 by 2 { }
	loop to 10 by 2 -> i {}
	loop to 10 { }
	loop to 10 -> i { }
	loop to 10 from 0 { }
	loop to 10 from 0 by 2 { }
	loop from 1 to -5 { }
	loop by 3 { }
	loop while true from 0 to 10 by 2 -> i { }
	loop by 2 to 10 from 0 -> i while true { }
	loop while true { }
	loop while true { }; print("hello") # That is allowed
	
	# not allowed (ranges must be together, 'while' cannot appear between):
	#  loop from 0 while true to 10 { }
	# not allowed (captures (-> i) must be done immediately after ranges or iterators):
	#  loop over my_list while true -> elm { }
	# not allowed (you cannot combine range and iterate):
	#  loop from 0 to 10 over my_list { }
	# not allowed (you cannot capture two things from range loops)
	#  loop to 10 -> i, j { }

	# 'while' can be combined with iterations and with ranges. The order is not enforced, but captures (-> i) cannot come *after* 'while'
	loop while some_condition() to 20 -> i {
		# This loop will print i from 0 to 19, but might stop if the `some_condition` function ever returns false
		print(i)
	}

	let my_list = List{ -10, 2, -120, null, 8 }
	loop over my_list -> elm while elm != null {
		# This loop will print 10, 2, 120.
		# The 'while elm != null' will cause the loop to stop when seeing the null value, thus never printing 8.
		print(Math.abs(elm))
	}

	# if statements
	if some_bool_expr {
		print("this code block runs when true")
	} elif another_bool_expr {
		print("this block runs when the first was false, but the second is true")
	} else {
		print("this block runs when all of the tests were false")
	}

	# if some_bool_expr {
		# code
	# } else if another_bool { # THIS LINE IS INVALID, MUST BE 'elif'
		# code
	# }

	# if expressions (like our old if, but without codeblocks)
	#   each branch can only contain one expression, no statements allowed!
	let mut value = select (x > 0: "bigger", x < 0: "smaller", true: "zero")

	select(false: "never", false: "still never", true: "always")
	select [x] (10: "if x is 10", 20: "if x is 20", 30: "if x is 30", x: "always")

	# switch statements
	switch some_int case 10 {
		print("ten")
	} case 20 {
		print("definitely twenty")
	} case 20, 30, 40 {
		print("maybe twenty, thirty or forty")
	} else {
		print("the number didn't match any of our checks")
	}
}

