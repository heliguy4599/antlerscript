# Can't have a declarator in the wild
# @a_decorator


# The idiomatic way of handling errors in AntlerScript is by using the Error
# class and passing a string to it for user feedback. To compare error types, it
# is entirely possible to use a Java-style inheritance chain and to check the
# error type, but idiomatically, errors should be globally allocated objects and
# returned errors should, if needed, be compared with those original objects.
# Pointer comparisons are fast and precise.

# Another useful pattern is Go's wrapped errors where functions have the classic
# Error() method to get the error message as a string, but also an Unwrap()
# function to get the "prototype chain" of the error. This is great for
# developers who want to have their own wrappers around error messages, like by
# wrapping "not found" into "database error: not found." This pattern is
# possible in AntlerScript, but a new class must be defined to signal this
# pattern. Possibly, "WrappedError" or something like that. It is currently
# uncertain whether the AS standard library will make use of such a pattern.

let err_not_found = Error{"item not found"}
let err_invalid_input = Error{"invalid input provided"}

# `! Error` indicates "I'm a function that throws, so it must be caught, and the
# thrown type is `Error`. A function cannot me marked as throwing with ! without
# actually throwing, and a function that throws must be marked as throwing with
# !
let find_user = Func(String id : String)! Error {
    if id == "" {
        # Functions that throw need to provide a default value for the normal
        # return value of the function. If the callee doesn't want to handle it
        # in the slightest, it can always pass NULL, like for complex objects
        throw err_invalid_input
    }

    if id == "admin" {
        return "Admin User"
    }

    throw err_not_found
}
let runner = Func(: Int)! Error {
    let String input = "user name"

    # Every throwing function must explicitely be handled by the parent scope of
    # the caller
    let String user = try find_user(input) else err { # `err`'s type cannot be
                                                      # specified. If you need
                                                      # your errors to be
                                                      # upcasted, what is wrong
                                                      # with you?
        print(user) # compile time crash, user cannot be read until it is written in this scope
        user = "not found"
        switch err case err_not_found {
            print("user not found for {input}")
        } case err_invalid_input {
            print("invalid input: '{input}' for find_user call")
        }

        # If user is never written to, the scope must be exited here
        # with return, continue, break, etc.
    }

    # When there is no else statement, just rethrow with the same type
    let example = try find_user("")
}

# Error is not a special type, this function doesn't need to be handled
let error_create = Func(String input : Error) {
    return Error{input}
}

# Weird, but okay
let return_error_code = Func(:)! Int {
    throw 9
}

### Coroutines

# AntlerScript coroutines are:
# 1. Stackless
# 2. Primitive (no async/await runtime baked in)
# 3. Asymmetric (cannot transfer ownership)
# 4. Bidirectional data transfer
# 5. No cancellation (User-based)
# 6. Unstructured (structure is user-based)
# 7. First-class coroutine handles (Tasks)

# Coroutines can't throw
let myCo = Coroutine(Float f : Class()) yield Int : String {
	print(f)

	let mut has_shat = false

	loop to 3 -> i {
		let String yielded = yield i
		if yielded == "poop" {
			has_shat = true
		}
	}

	if has_shat {
		return object{}
	} else {
		return Error{"has not shat"}
	}
}

# TODO: figure out how to write the type of the task (it only cares about the return type, and yield input/output types
let myTask = myCo(10.2) # Prints 10.2
print(myTask.next("not poop")) # Prints 0, true
print(myTask.is_done) # Prints false
print(myTask.next("not poop")) # Prints 1, true
print(myTask.next("not poop")) # Prints 2, true
print(myTask.next("not poop")) # Prints 2, false (because invalid yield)
print(myTask.is_done) # Prints true

let result1 = myTask.retrieve_or_panic()
let result2 = try myTask.retrieve() else err {
	# Not gonna run
	print(err is string) # true
	print(err) # would run something like "invalid coroutine state"
}

return result1 == result2 # true


# # C API Design
# 1. All glue code is on the AntlerScript side
# 2. Slots (ephemeral) and handles (long lasting) for C to call in AntlerScript (no ABI)
# 3. Arenas for AntlerScript to pass to a C call
# 4. GC paused while calling C
# 5. GC doesn't free stuff in slots and handles
# Big inspiration: Wren + Java Panama
# No syntax defined yet because no new core syntax must be present for the C API
# to work, only standard library interfaces, which will come later

# Runtime
# The main runtime of AntlerScript will be an embeddable bytecode VM written in
# Go. It will compile to a C library using CGO (both static and dynamic will be
# availble, as well as source), and there will also be a wrapper available
# around the AntlerScript VM library to simply call AntlerScript as-is. It will
# be similar to Lua (lua/liblua.so) or QuickJS (qjs/libquickjs.so)

# // Note: how to pause the GC in Go:
# // Force any in-flight cycle to complete first
# runtime.GC()
# // Now disable — no new cycles will start
# prev := debug.SetGCPercent(-1)
# defer debug.SetGCPercent(prev)

# Generics

# Generic classes

# Normal class
type Printable = Class(
	let Func(:String) to_string
)

# Generic class (types are restrictions, not actual types. Any means no restrictions)
type Element = Class<Any T>(
	let T value
	constructor(value){}
)

type Pair = Class<Any T, Printable & Element<T> A, Printable & Element<T> B>(
	let A a,
	let B b,
	constructor(a, b, T t){
		# No type erasure
		print(Class(
			extends A,
			# Type information of T is still available
			# Assuming Strings.convert<Any T> exists in the std lib
			to_string = Func(:String){return Strings.convert<T>(value)},
			constructor(value){},
		){t}.to_string())
	},
)

# Generic functions

type Comparable = Class(
	let Func(Self : Bool) greater_than
)

let myfunc = Func<Comparable T>(T a, T b : Bool) {
	return a.greater_than(b)
}


# Inferences

let item = 10 # item is inferred to be Int

List{10, 20} # inferred to be List<Int>

type MyClass = Class<Any T>(
    T item
    constructor(item){}
)
let mc = MyClass{"hi"} # inferred to be MyClass<String>

Func(: List<Int>) {
    return List{} # inferred to be List<Int>, known from the func's return type
}

let List<Int> ls = List{} # inferred to be List<Int>, know from the target (variable ls)

let Func(Int, Int : Int) add = Func(a, b) { a + b } # inferred to be Func(Int, Int : Int), known from the target (variable add)

# in my opinion, the following should NOT be allowed:
# let Func(Int, Int : Int) add = Func(a, Int b) { a + b }
# let Func(Int, Int : Int) add = Func(a, b : Int) { a + b }
# let Func(Int, Int : Int) add = Func(Int a, Int b) { a + b }
# essentially, infer all or infer none, no mixing

# IMPORTANT NEW RULE
# Class constructors get REMOVED in the new type of a generic or type union and intersections

type MyClass = Class(
	let String i
	constructor(i){}
)

let make_new = Func<MyClass T>(: T) {
    return T{"some string"} # this can't be allowed, we don't know T's constructor type
}