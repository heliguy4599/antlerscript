const fn = Func(:){}

# Decorators are simple wrapper functions
# Decorators are defined as functions (local, namespace, or class)
# The first argument of decorators needs to be the function that is passed to it, and it must return a lambda of the same type which will be called when the original function is called instead
# Decorators are evaluated at definition time, not instantiation time
# Decorators can have arguments, and can be chained
# Decorators are called top to bottom, but evaluated bottom to top
let cheese = Func(Func(:) f: Func(:)) {
	return Func(:) {
		print("cheese!!")
		f()
	}
}
@cheese # or @cheese()
let func_with_dec = Func(:){}

# Enums
type Directions = Enum(
  UP,
  DOWN,
  LEFT,
  RIGHT,
)
# ...
let Directions dir = Directions.UP
type MoreDirections = Enum(
  extends Directions,
  FORWARD,
  BACKWARD,
)
let mut MoreDirections more_dir = MoreDirections.FORWARD
more_dir = MoreDirections.UP
more_dir = Directions.RIGHT
# all of these are valid

# Enums naturally support binary flags. Meaning that you can always do
# Directions.UP | Directions.DOWN to mean either, and myDirs & Direction.UP to
# check if it contains Direction.UP. All enums have the value "NONE" (so, it is
# reserved), so Direction.UP & Direction.DOWN == Direction.NONE, even if it is
# never explicitly defined in the enum

# Enums can be turned into strings baked in with `MyEnum.VALUE as String`

